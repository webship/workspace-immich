{
  "name": "@webship.co/workspace-immich",
  "version": "1.0.0",
  "description": "Immich for Webship Workspace: the builder (`cmd-immich-project.sh`) in every sites folder, which makes an Immich library from its release (v3.4.2) and serves it from containers of its own: its server, its Postgres with the vector extensions and valkey, each pinned by digest, machine learning off, the photos in the project's library/ folder (DDEV by default, or Docker Compose, Podman or Kubernetes with --runtime). Its accounts made through the library's API past the first-run wizard, its version check off by default, its database backed up and restored through the core's database hook the way Immich backs itself up (pg_dump --clean --if-exists, psql --single-transaction), the Immich step pack wired into the testing setup of such a library, and its AI items in their folders: two agents, a skill, a command and two prompts for building and testing Immich libraries.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-immich.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "immich",
    "label": "Immich",
    "settingsFile": "plugin.immich.settings.yml",
    "settingsTemplate": "config/plugin.immich.settings.yml",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-immich-project.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-immich.sh"
      ],
      "args": [
        "scripts/args/arg-immich.sh"
      ],
      "machine": [
        "scripts/docker-compose.immich.yaml",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/immich-library-builder.md",
        "ai/agents/immich-tester.md"
      ],
      "skills": [
        "ai/skills/immich-scenarios"
      ],
      "commands": [
        "ai/commands/immich-test.md"
      ],
      "prompts": [
        "ai/prompts/immich-build-and-test.md",
        "ai/prompts/immich-scenarios-for-a-library.md"
      ]
    },
    "features": [
      "features/immich.feature",
      "features/immich-runtimes.feature"
    ],
    "featuresSite": "cmd-immich-project.sh ci-immich --install --add-users --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.13",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
